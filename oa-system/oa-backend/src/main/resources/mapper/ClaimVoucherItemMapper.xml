<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oa.backend.mapper.ClaimVoucherItemMapper">

    <resultMap id="BaseResultMap" type="com.oa.backend.entity.ClaimVoucherItem">
        <id column="id" property="id"/>
        <result column="claim_voucher_id" property="claimVoucherId"/>
        <result column="item" property="item"/>
        <result column="amount" property="amount"/>
        <result column="comment" property="comment"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, claim_voucher_id, item, amount, comment
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO claim_voucher_item (claim_voucher_id, item, amount, comment)
        VALUES (#{claimVoucherId}, #{item}, #{amount}, #{comment})
    </insert>

    <update id="update">
        UPDATE claim_voucher_item
        SET item = #{item},
            amount = #{amount},
            comment = #{comment}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM claim_voucher_item WHERE id = #{id}
    </delete>

    <delete id="deleteByClaimVoucherId">
        DELETE FROM claim_voucher_item WHERE claim_voucher_id = #{claimVoucherId}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM claim_voucher_item
        WHERE id = #{id}
    </select>

    <select id="selectByClaimVoucherId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM claim_voucher_item
        WHERE claim_voucher_id = #{claimVoucherId}
    </select>
</mapper>
