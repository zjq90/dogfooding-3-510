<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oa.backend.mapper.OperationLogMapper">

    <resultMap id="BaseResultMap" type="com.oa.backend.entity.OperationLog">
        <id column="id" property="id"/>
        <result column="employee_id" property="employeeId"/>
        <result column="operation_time" property="operationTime"/>
        <result column="operation" property="operation"/>
        <association property="employee" javaType="com.oa.backend.entity.Employee">
            <id column="emp_id" property="id"/>
            <result column="emp_name" property="name"/>
            <result column="emp_post" property="post"/>
        </association>
    </resultMap>

    <sql id="Base_Column_List">
        l.id, l.employee_id, l.operation_time, l.operation
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO log (employee_id, operation_time, operation)
        VALUES (#{employeeId}, #{operationTime}, #{operation})
    </insert>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>,
            e.id AS emp_id,
            e.name AS emp_name,
            e.post AS emp_post
        FROM log l
        LEFT JOIN employee e ON e.id = l.employee_id
        ORDER BY l.operation_time DESC
    </select>
</mapper>
