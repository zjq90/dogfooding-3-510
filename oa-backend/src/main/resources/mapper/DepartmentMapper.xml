<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cd.oa.mapper.DepartmentMapper">

    <resultMap id="departmentResultMap" type="com.cd.oa.entity.Department">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
    </resultMap>

    <sql id="baseColumnList">
        id, name, address
    </sql>

    <insert id="insert" parameterType="com.cd.oa.entity.Department">
        INSERT INTO department (id, name, address)
        VALUES (#{id}, #{name}, #{address})
    </insert>

    <update id="update" parameterType="com.cd.oa.entity.Department">
        UPDATE department
        SET name = #{name},
            address = #{address}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="string">
        DELETE FROM department WHERE id = #{id}
    </delete>

    <select id="selectById" parameterType="string" resultMap="departmentResultMap">
        SELECT <include refid="baseColumnList"/>
        FROM department
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="departmentResultMap">
        SELECT <include refid="baseColumnList"/>
        FROM department
        ORDER BY id
    </select>

</mapper>
